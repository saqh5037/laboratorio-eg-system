# PRODUCCIÓN - Configuración de Variables de Entorno
# IMPORTANTE: Copiar este archivo a .env.production y configurar con URLs de producción

# === PRODUCCIÓN ===
NODE_ENV=production

# PostgreSQL Database (Backend usa estas variables)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=labsisEG
DB_USER=labsis
DB_PASSWORD=CAMBIAR_EN_PRODUCCION
DB_SSL=false

# API Server
API_PORT=3001
API_HOST=0.0.0.0

# === URLs de APIs en Producción ===
# CRÍTICO: Configurar con el dominio de producción
# Ejemplo: https://laboratorio-eg.com

# Frontend API URL
# Opciones:
# - URL completa: https://laboratorio-eg.com/api
# - Ruta relativa: /api (si frontend y backend están en el mismo dominio)
VITE_API_URL=https://laboratorio-eg.com/api

# Results Service API URL
VITE_RESULTS_API_URL=https://laboratorio-eg.com/api/results

# Config Service API URL
VITE_CONFIG_API_URL=https://laboratorio-eg.com

# Messaging Bot Service API URL
VITE_MESSAGING_BOT_API_URL=https://laboratorio-eg.com/api/messaging

# Config API Settings
VITE_CONFIG_CACHE_TTL=300000
VITE_CONFIG_POLL_INTERVAL=30000

# === PWA Configuration ===
VITE_APP_NAME="Laboratorio Elizabeth Gutiérrez"
VITE_APP_SHORT_NAME="Lab EG"
VITE_APP_DESCRIPTION="Sistema de gestión de estudios clínicos y análisis de laboratorio"

# Push Notifications (VAPID Keys)
# Generar con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=CAMBIAR_CON_CLAVE_REAL
VAPID_PRIVATE_KEY=CAMBIAR_CON_CLAVE_REAL

# === Feature Flags ===
VITE_ENABLE_PUSH_NOTIFICATIONS=false
VITE_ENABLE_BACKGROUND_SYNC=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_DATABASE=true

# === Cache Configuration ===
CACHE_TTL=300
CACHE_MAX_KEYS=1000

# === Security ===
JWT_SECRET=CAMBIAR_CON_CLAVE_SEGURA_DE_PRODUCCION
SESSION_SECRET=CAMBIAR_CON_CLAVE_SEGURA_DE_PRODUCCION
CORS_ORIGIN=https://laboratorio-eg.com

# === Monitoring ===
SENTRY_DSN=
ENABLE_PERFORMANCE_MONITORING=true

# === Production Settings ===
VITE_DEBUG_MODE=false
VITE_MOCK_API=false

# === Laboratory Specific ===
VITE_LAB_PHONE="+58 (212) 555-1234"
VITE_LAB_EMAIL="contacto@laboratorio-eg.com"
VITE_LAB_ADDRESS="Caracas, Venezuela"

# === Social Media ===
VITE_FACEBOOK_URL="https://facebook.com/laboratorio-eg"
VITE_TWITTER_URL="https://twitter.com/laboratorio_eg"
VITE_INSTAGRAM_URL="https://instagram.com/laboratorio_eg"
