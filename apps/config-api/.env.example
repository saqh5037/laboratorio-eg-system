# ==============================================
# CONFIG API - Environment Variables
# ==============================================
# REQUIRED variables MUST be set for the server to start
# Copy this file to .env and configure your values
# ==============================================

# Server Configuration (REQUIRED)
PORT=3005
NODE_ENV=development

# Public URL (REQUIRED)
# Used for webhooks, deep links, and external references
# In Docker: http://config-api:3005
# In local: http://localhost:3005
PUBLIC_URL=http://localhost:3005

# Database Configuration (REQUIRED)
# Database: lis_bot_comunicacion
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lis_bot_comunicacion
DB_USER=labsis
DB_PASSWORD=labsis
DB_MAX_CONNECTIONS=20
DB_SSL=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=8h

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Cache
CACHE_TTL_SECONDS=300
CACHE_CHECK_PERIOD_SECONDS=60

# WebSocket
WS_PORT=3006
WS_HEARTBEAT_INTERVAL=30000

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/config-api.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
