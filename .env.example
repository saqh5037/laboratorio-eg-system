# ==========================================
# Laboratorio EG System - Environment Variables
# ==========================================
# Copy this file to .env and configure your values
# REQUIRED variables must be set for the system to work
# ==========================================

# ==========================================
# General Configuration
# ==========================================
NODE_ENV=production
LOG_LEVEL=info

# ==========================================
# Database Configuration (REQUIRED)
# ==========================================
DB_PASSWORD=labsis
DB_PORT=5432
DB_MAX_CONNECTIONS=20

# ==========================================
# JWT Authentication (REQUIRED - CHANGE IN PRODUCTION!)
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# ==========================================
# CORS Configuration
# ==========================================
CORS_ORIGIN=http://localhost:5173,http://localhost

# ==========================================
# Public URLs (REQUIRED for webhooks and external access)
# ==========================================
PUBLIC_URL=http://localhost

# ==========================================
# Frontend URLs (REQUIRED)
# ==========================================
VITE_API_URL=http://localhost:3002/api
VITE_CONFIG_API_URL=http://localhost:3005
VITE_RESULTS_API_URL=http://localhost:3003
VITE_MESSAGING_BOT_API_URL=/api/messaging
WEB_PORT=80

# ==========================================
# Telegram Bot Configuration (REQUIRED for messaging-bot)
# ==========================================
# Get these from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# ==========================================
# WhatsApp (Twilio) Configuration (REQUIRED for messaging-bot)
# ==========================================
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# Gemini AI Configuration (REQUIRED for messaging-bot)
# ==========================================
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Cache Configuration (Optional)
# ==========================================
CACHE_TTL_SECONDS=300
CACHE_CHECK_PERIOD_SECONDS=60

# ==========================================
# WebSocket Configuration (Optional)
# ==========================================
WS_HEARTBEAT_INTERVAL=30000

# ==========================================
# Rate Limiting (Optional)
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
