# ==========================================
# Laboratorio EG System - PRODUCCIÓN AWS EC2
# ==========================================
# Copy this file to .env for production deployment
# REQUIRED variables must be set for the system to work
# ==========================================

# ==========================================
# General Configuration
# ==========================================
NODE_ENV=production
LOG_LEVEL=info

# ==========================================
# Database Configuration (REQUIRED)
# ==========================================
# DB_HOST: localhost si PostgreSQL está en la misma instancia EC2
# En producción cambiar a RDS endpoint si usas Amazon RDS
DB_HOST=localhost
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
DB_PORT=5432
DB_MAX_CONNECTIONS=20

# Nombres de bases de datos en producción
DB_NAME_LABSIS=labsisEGProduccion
DB_NAME_BOT=lis_bot_comunicacioneg

# ==========================================
# JWT Authentication (REQUIRED - CHANGE IN PRODUCTION!)
# ==========================================
# Generate new secret with: openssl rand -hex 32
JWT_SECRET=GENERATE_NEW_256_BIT_SECRET_HERE
JWT_EXPIRATION=24h

# ==========================================
# CORS Configuration
# ==========================================
# Agregar tu dominio personalizado aquí
CORS_ORIGIN=http://54.197.68.252,https://54-197-68-252.nip.io,https://laboratorio-eg.com

# ==========================================
# Public URLs (REQUIRED for webhooks and external access)
# ==========================================
# Cambiar a tu IP de EC2 o dominio personalizado
PUBLIC_URL=http://54.197.68.252

# ==========================================
# Frontend URLs (REQUIRED)
# ==========================================
VITE_API_URL=http://54.197.68.252:3002/api
VITE_CONFIG_API_URL=http://54.197.68.252:3005
VITE_RESULTS_API_URL=http://54.197.68.252:3003
VITE_MESSAGING_BOT_API_URL=/api/messaging
WEB_PORT=80

# ==========================================
# Telegram Bot Configuration (REQUIRED for messaging-bot)
# ==========================================
# Get these from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=YOUR_BOT_USERNAME

# ==========================================
# WhatsApp (Twilio) Configuration (REQUIRED for messaging-bot)
# ==========================================
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# Gemini AI Configuration (REQUIRED for messaging-bot)
# ==========================================
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ==========================================
# Cache Configuration (Optional)
# ==========================================
CACHE_TTL_SECONDS=300
CACHE_CHECK_PERIOD_SECONDS=60

# ==========================================
# WebSocket Configuration (Optional)
# ==========================================
WS_HEARTBEAT_INTERVAL=30000

# ==========================================
# Rate Limiting (Optional)
# ==========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# ==========================================
# NOTAS IMPORTANTES
# ==========================================
# 1. NUNCA subir este archivo con valores reales a Git
# 2. Cambiar TODOS los secretos (JWT_SECRET, DB_PASSWORD)
# 3. Verificar que las bases de datos existan en PostgreSQL
# 4. Configurar Security Group en AWS para abrir puertos:
#    - 80 (HTTP)
#    - 3002-3006 (APIs)
# 5. Considerar usar AWS Secrets Manager para secretos sensibles
