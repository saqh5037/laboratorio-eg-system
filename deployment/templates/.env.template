# ==========================================
# Laboratorio ${LAB_NAME} - Production Environment
# ==========================================
# Instance: ${LAB_CODE}
# Generated: $(date)
# ==========================================

# ==========================================
# Instance Identification
# ==========================================
LAB_CODE=${LAB_CODE}
LAB_NAME="${LAB_NAME}"
INSTANCE_PREFIX=${INSTANCE_PREFIX}

# ==========================================
# General Configuration
# ==========================================
NODE_ENV=production
LOG_LEVEL=info

# ==========================================
# Database Configuration (REQUIRED)
# ==========================================
DB_HOST=${DB_HOST:-localhost}
DB_PORT=5432
DB_PASSWORD=${DB_PASSWORD}
DB_MAX_CONNECTIONS=20

# Database names for this lab instance
# labsisXX = lab data (studies, patients, results)
# lis_bot_comunicacionXX = config, landing, bot data
DB_NAME_LABSIS=${DB_NAME_LABSIS}
DB_NAME_BOT=${DB_NAME_BOT}

# ==========================================
# JWT Authentication (REQUIRED)
# ==========================================
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRATION=24h

# ==========================================
# URLs Configuration
# ==========================================
# Domain or IP for this instance
PUBLIC_URL=${PUBLIC_URL}

# CORS - domains allowed to access the APIs
CORS_ORIGIN=${CORS_ORIGIN}

# ==========================================
# Frontend API URLs
# ==========================================
VITE_API_URL=${PUBLIC_URL}:3002/api
VITE_CONFIG_API_URL=${PUBLIC_URL}:3005
VITE_RESULTS_API_URL=${PUBLIC_URL}:3003
VITE_MESSAGING_BOT_API_URL=/api/messaging

# Port for web frontend (usually 80 or custom)
WEB_PORT=${WEB_PORT:-80}

# ==========================================
# Telegram Bot (per-lab bot)
# ==========================================
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
TELEGRAM_BOT_USERNAME=${TELEGRAM_BOT_USERNAME}

# ==========================================
# WhatsApp (Twilio) - Optional
# ==========================================
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID:-}
TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN:-}
TWILIO_PHONE_NUMBER=${TWILIO_PHONE_NUMBER:-}

# ==========================================
# Gemini AI (for bot assistant)
# ==========================================
GEMINI_API_KEY=${GEMINI_API_KEY:-}

# ==========================================
# Cache Configuration
# ==========================================
CACHE_TTL_SECONDS=300
CACHE_CHECK_PERIOD_SECONDS=60

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
